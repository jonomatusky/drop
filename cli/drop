DEFAULT_GITLEAKS_CONFIG = Path(__file__).resolve().parent / "drop-gitleaks.toml"

SECRET_FILE_RE = re.compile(
    r"(^|/)(\.env(\..*)?|\.npmrc|\.pypirc|id_rsa|id_dsa|id_ed25519|.*\.pem|.*\.key|credentials|secrets?)(/|$)",
    re.IGNORECASE,
)
ARCHIVE_RE = re.compile(r"\.(zip|tar|tgz|tar\.gz|tar\.bz2|tar\.xz|7z|rar)$", re.IGNORECASE)
IMAGE_RE = re.compile(r"\.(png|jpe?g|gif|webp|tiff?|bmp)$", re.IGNORECASE)
TEXTISH_RE = re.compile(r"\.(html?|css|js|mjs|json|txt|md|csv|xml|svg|log|map|yaml|yml)$", re.IGNORECASE)
EMAIL_RE = re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.IGNORECASE)
SSN_RE = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
CREDENTIAL_RE = re.compile(r"\b(password|passwd|pwd|api[_-]?key|secret|token)\b\s*[:=]\s*['\"]?[^'\"\s]{8,}", re.IGNORECASE)
URL_ATTRS = {"src", "href", "poster", "data", "action"}

# Image formats accepted by --card-image, with the og:image:type each declares.
# Named here rather than read from mimetypes, whose table varies by platform
# (older Pythons have no entry for .webp at all).
CARD_IMAGE_TYPES = {
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
}
# Same reason: without this, a .webp would upload as application/octet-stream.
mimetypes.add_type("image/webp", ".webp")


class PublishError(Exception):
    pass


class AssetParser(html.parser.HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.urls: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        for key, value in attrs:
            if key and key.lower() in URL_ATTRS and value and re.match(r"^https?://", value, re.I):
                self.urls.append(value)


def die(message: str, code: int = 1) -> None:
    print(f"drop: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(cmd: list[str], *, env: dict[str, str] | None = None, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(cmd, input=input_bytes, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, check=False)


def _keychain_get(service: str) -> str | None:
    """Optional macOS keychain convenience. Returns the secret or None.

    Prefers a `kc-get <service>` helper on PATH if present, else falls back to
    `security find-generic-password`. Set DROP_KEYCHAIN_ACCOUNT to scope the
    lookup to a specific keychain account.
    """
    helper = shutil.which("kc-get")
    if helper:
        proc = run([helper, service])
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.decode().strip()
        return None
    if sys.platform == "darwin" and shutil.which("security"):
        cmd = ["security", "find-generic-password", "-s", service, "-w"]
        account = os.environ.get("DROP_KEYCHAIN_ACCOUNT")
        if account:
            cmd[1:1] = ["-a", account]
        proc = run(cmd)
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.decode().strip()
    return None


def get_secret(env_name: str, keychain_service: str, label: str) -> str:
    """Env var first, then the optional keychain fallback. Errors clearly if
    neither is set, so a stranger never has to read source to know what's missing."""
    val = os.environ.get(env_name)
    if val and val.strip():
        return val.strip()
    val = _keychain_get(keychain_service)
    if val:
        return val
    raise PublishError(
        f"missing {label}: set ${env_name} "
        f"(or store it in the macOS keychain as '{keychain_service}')"
    )


def require_env(name: str, label: str) -> str:
    val = os.environ.get(name)
    if not val or not val.strip():
        raise PublishError(f"missing {label}: set ${name}")
    return val.strip()


def base_url() -> str:
    return require_env("DROP_BASE_URL", "Worker base URL").rstrip("/")


def utc_now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def parse_duration(value: str) -> dt.datetime:
    match = re.fullmatch(r"(\d+)([smhdw])", value.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError("--expire must look like 30m, 7d, or 2w")
    amount = int(match.group(1))
    unit = match.group(2)
    seconds = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[unit] * amount
    return utc_now() + dt.timedelta(seconds=seconds)


SLUG_ALPHABET = "abcdefghijklmnopqrstuvwxyz0123456789"
# Unlisted ("secret link") shares have no password — the unguessable URL IS the
# only gate, and public slugs are NOT rate-limited at the Worker (rate limiting
# only fires on failed password auth). So the tail must be strong: 16 base36
# chars ≈ 82 bits, far beyond any HTTP enumeration.
SECRET_SLUG_LEN = 16


def readable_slug(value: str) -> str:
    """Human-readable slug: lowercase, hyphen-joined, no leading/trailing hyphen,
    capped at 40 chars. Clean and id-free — uniqueness is handled separately, at
    publish time, by resolve_unique_slug."""
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return slug[:40].strip("-")


def generated_slug(readable_source: str | None, *, secret: bool = False) -> str:
    """The slug for an artifact, e.g. ``ted-page`` — from --client/--label or the
    artifact's file/dir name. ``secret=True`` (unlisted shares) appends an
    unguessable ~82-bit tail (``ted-page-k7f3m9q2x8p4n6tz``) so the URL itself is
    the capability. Otherwise it's a clean, id-free name; a clash is resolved by
    resolve_unique_slug appending -2, -3 … at publish time."""
    base = readable_slug(readable_source or "") or "share"
    if secret:
        tail = "".join(secrets.choice(SLUG_ALPHABET) for _ in range(SECRET_SLUG_LEN))
        return f"{base}-{tail}"
    return base


def looks_unlisted(slug: str) -> bool:
    """True if a slug carries the unguessable tail that ``generated_slug(secret=
    True)`` mints: a readable base, a hyphen, then exactly SECRET_SLUG_LEN chars
    from SLUG_ALPHABET.

    The tail must also contain at least one digit. A public slug can end in a
    16-letter word (``…-characterization``) that is otherwise the same shape as a
    tail, and calling it unlisted would bless a guessable URL as a secret one. A
    random base36 tail is all letters only (26/36)^16 ≈ 0.55% of the time, so the
    rule turns away about one real unlisted slug in 180. That owner still has
    ``drop update <slug>``, which keeps the slug and the no-password tier without
    needing this check."""
    base, sep, tail = slug.rpartition("-")
    if not sep or not base:
        return False
    return (
        len(tail) == SECRET_SLUG_LEN
        and all(c in SLUG_ALPHABET for c in tail)
        and any(c.isdigit() for c in tail)
    )


def iter_files(path: Path) -> list[tuple[Path, str]]:
    if not path.exists():
        raise PublishError(f"path not found: {path}")
    if path.is_file():
        return [(path, path.name)]
    if not path.is_dir():
        raise PublishError(f"unsupported path: {path}")
    root = path.resolve()
    files: list[tuple[Path, str]] = []
    for item in sorted(path.rglob("*")):
        # A symlink (file or dir) inside the tree can resolve to a target
        # outside the selected publish root and leak it under a harmless-looking
        # relative name, bypassing the publish boundary and the filename guard.
        # Reject any link that escapes the root; links that stay inside resolve
        # to real files and are published normally (intentional aliases).
        if item.is_symlink():
            target = item.resolve()
            if target != root and root not in target.parents:
                rel = item.relative_to(path).as_posix()
                raise PublishError(
                    f"refusing to publish symlink that escapes the publish root: {rel} -> {target}"
                )
        if item.is_file():
            rel = item.relative_to(path).as_posix()
            files.append((item, rel))
    if not files:
        raise PublishError(f"no files to publish: {path}")
    return files


def scan_secret_filenames(files: list[tuple[Path, str]]) -> list[str]:
    return [rel for _, rel in files if SECRET_FILE_RE.search(rel)]


def scan_archives(files: list[tuple[Path, str]]) -> list[str]:
    return [rel for _, rel in files if ARCHIVE_RE.search(rel)]


def read_text(path: Path, max_bytes: int = 2_000_000) -> str:
    data = path.read_bytes()[:max_bytes]
    return data.decode("utf-8", errors="ignore")


def pii_scan_text(text: str) -> tuple[list[str], list[str]]:
    high: list[str] = []
    warn: list[str] = []
    emails = sorted(set(EMAIL_RE.findall(text)))
    if len(emails) >= 10:
        high.append(f"bulk email addresses ({len(emails)} unique)")
    elif emails:
        warn.append(f"email addresses ({len(emails)} unique)")
    if SSN_RE.search(text):
        high.append("SSN-like value")
    if CREDENTIAL_RE.search(text):
        high.append("credential-shaped assignment")
    return high, warn


def scan_pii(files: list[tuple[Path, str]]) -> tuple[list[str], list[str]]:
    high: list[str] = []
    warn: list[str] = []
    for path, rel in files:
        if TEXTISH_RE.search(rel):
            h, w = pii_scan_text(read_text(path))
            high.extend(f"{rel}: {item}" for item in h)
            warn.extend(f"{rel}: {item}" for item in w)
    return high, warn


def run_gitleaks(path: Path) -> list[dict]:
    gitleaks = shutil.which("gitleaks")
    if not gitleaks:
        raise PublishError("gitleaks is required for the publish preflight (install it before publishing)")
    config_path = Path(os.environ.get("DROP_GITLEAKS_CONFIG", DEFAULT_GITLEAKS_CONFIG)).expanduser()
    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as report:
        report_path = Path(report.name)
    try:
        cmd = [gitleaks, "detect", "--no-git", "--source", str(path), "--report-format", "json", "--report-path", str(report_path)]
        if config_path.exists():
            cmd.extend(["--config", str(config_path)])
        proc = run(cmd)
        if report_path.exists() and report_path.stat().st_size:
            try:
                findings = json.loads(report_path.read_text())
            except json.JSONDecodeError:
                findings = [{"description": "gitleaks returned unreadable JSON"}]
        else:
            findings = []
        if proc.returncode not in (0, 1):
            stderr = proc.stderr.decode(errors="ignore").strip()
            raise PublishError(f"gitleaks failed: {stderr or f'exit {proc.returncode}'}")
        return findings if isinstance(findings, list) else [findings]
    finally:
        report_path.unlink(missing_ok=True)


def scan_external_assets(files: list[tuple[Path, str]]) -> list[str]:
    warnings: list[str] = []
    for path, rel in files:
        if not rel.lower().endswith((".html", ".htm")):
            continue
        parser = AssetParser()
        try:
            parser.feed(read_text(path))
        except Exception:
            continue
        for url in sorted(set(parser.urls)):
            warnings.append(f"{rel}: external asset {url}")
    return warnings


def scan_images(files: list[tuple[Path, str]], confirm_limitation: bool) -> tuple[list[str], list[str], list[str]]:
    images = [(path, rel) for path, rel in files if IMAGE_RE.search(rel)]
    if not images:
        return [], [], []
    tesseract = shutil.which("tesseract")
    if not tesseract:
        if not confirm_limitation:
            raise PublishError("image files are present but OCR is unavailable; rerun with --confirm-image-limitation after reviewing them manually")
        return [], [f"image contents not OCR-scanned ({len(images)} image files; explicit limitation accepted)"], []
    high: list[str] = []
    warn: list[str] = []
    ocr_paths: list[str] = []
    for path, rel in images:
        proc = run([tesseract, str(path), "stdout"])
        if proc.returncode != 0:
            if not confirm_limitation:
                raise PublishError(f"OCR failed for {rel}; rerun with --confirm-image-limitation after manual review")
            warn.append(f"{rel}: OCR failed; explicit limitation accepted")
            continue
        ocr_paths.append(rel)
        h, w = pii_scan_text(proc.stdout.decode("utf-8", errors="ignore"))
        high.extend(f"{rel} OCR: {item}" for item in h)
        warn.extend(f"{rel} OCR: {item}" for item in w)
    return high, warn, ocr_paths


def public_confirm(args: argparse.Namespace) -> None:
    if args.yes:
        return
    preview = (
        "Its link preview (title, description and card image) is viewable by anyone "
        "with the link, without the password. "
        if getattr(args, "public_preview", False)
        else ""
    )
    prompt = (
        "This artifact goes on the public internet. It may be cached, indexed, "
        f"forwarded, and survive deletion. {preview}Type 'publish' to continue: "
    )
    if not sys.stdin.isatty():
        raise PublishError("refusing non-interactive publish without --yes")
    if input(prompt).strip() != "publish":
        raise PublishError("publish cancelled")


def preflight(path: Path, files: list[tuple[Path, str]], args: argparse.Namespace) -> dict:
    """Scan everything that will be published. ``files`` is the artifact's own
    files plus any file staged in from outside it (an external --card-image), so
    the filename, PII, and OCR passes cover both. gitleaks scans ``path`` only —
    the artifact root — which is all it can point at."""
    blocks: list[str] = []
    warnings: list[str] = []
    override_log: list[dict] = []

    secret_names = scan_secret_filenames(files)
    if secret_names:
        blocks.extend(f"secret filename: {name}" for name in secret_names)

    archives = scan_archives(files)
    if archives:
        blocks.extend(f"archive blocked in v1: {name}" for name in archives)

    gitleaks_findings = run_gitleaks(path)
    if gitleaks_findings:
        if args.allow_secret:
            override_log.append({"type": "secret", "reason": args.allow_secret})
            warnings.append(f"gitleaks findings overridden ({len(gitleaks_findings)})")
        else:
            blocks.append(f"gitleaks secret findings: {len(gitleaks_findings)}")

    pii_high, pii_warn = scan_pii(files)
    warnings.extend(pii_warn)
    if pii_high:
        if args.allow_pii:
            override_log.append({"type": "pii", "reason": args.allow_pii})
            warnings.extend(f"PII override: {item}" for item in pii_high)
        else:
            blocks.extend(f"high-confidence PII: {item}" for item in pii_high)

    image_high, image_warn, ocr_paths = scan_images(files, args.confirm_image_limitation)
    warnings.extend(image_warn)
    if image_high:
        if args.allow_pii:
            override_log.append({"type": "image-pii", "reason": args.allow_pii})
            warnings.extend(f"image PII override: {item}" for item in image_high)
        else:
            blocks.extend(f"high-confidence image PII: {item}" for item in image_high)

    warnings.extend(scan_external_assets(files))

    if blocks:
        raise PublishError("preflight blocked:\n  - " + "\n  - ".join(blocks))

    return {
        "status": "passed",
        "warnings": warnings,
        "gitleaks_findings": len(gitleaks_findings),
        "secret_filename_hits": secret_names,
        "ocr_scanned": ocr_paths,
        "image_limitation_accepted": bool(image_warn and args.confirm_image_limitation),
        "override_log": [
            {**item, "actor": _actor(), "host": socket.gethostname(), "at": utc_now().isoformat()}
            for item in override_log
        ],
    }


def _actor() -> str:
    """A best-effort uploader identity for the audit trail (no hard dependency on
    a populated passwd entry, which can be empty in containers)."""
    return os.environ.get("DROP_ACTOR") or os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"


def digest_files(files: list[tuple[Path, str]]) -> tuple[str, int, list[dict]]:
    sha = hashlib.sha256()
    total = 0
    file_rows: list[dict] = []
    for path, rel in files:
        file_sha = hashlib.sha256()
        size = path.stat().st_size
        total += size
        sha.update(rel.encode())
        sha.update(b"\0")
        with path.open("rb") as handle:
            while True:
                chunk = handle.read(1024 * 1024)
                if not chunk:
                    break
                sha.update(chunk)
                file_sha.update(chunk)
        file_rows.append({"path": rel, "bytes": size, "sha256": file_sha.hexdigest(), "content_type": content_type_for(rel)})
    return sha.hexdigest(), total, file_rows


def password_verifier(password: str) -> dict:
    salt = secrets.token_bytes(16)
    # Cloudflare Workers' WebCrypto caps PBKDF2 at 100k iterations (it throws
    # NotSupportedError above that), and the Worker verifies with this same count,
    # so it must stay <= 100000. 100k is the strongest the runtime allows.
    iterations = 100_000
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
    return {
        "algorithm": "pbkdf2-sha256",
        "iterations": iterations,
        "salt": base64.b64encode(salt).decode(),
        "hash": digest.hex(),
    }


def admin_request(method: str, path: str, token: str, payload: dict | None = None) -> dict:
    base = base_url()
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        f"{base}{path}",
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            # Cloudflare's edge 1010-blocks python-urllib's default UA on some paths.
            "User-Agent": "drop-cli/1.0",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode()
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as err:
        body = err.read().decode(errors="ignore")
        raise PublishError(f"admin API {method} {path} -> HTTP {err.code}: {body.strip() or '<empty>'}") from err
    except urllib.error.URLError as err:
        raise PublishError(f"admin API unavailable: {err}") from err


def _r2_account_id() -> str:
    return require_env("DROP_CF_ACCOUNT_ID", "Cloudflare account id")


def s3_request(
    method: str,
    bucket: str,
    key: str = "",
    *,
    body: bytes = b"",
    query: str = "",
    content_type: str | None = None,
    timeout: int = 60,
) -> tuple[int, bytes]:
    """Signed (AWS SigV4) request to R2's S3 endpoint with the bucket-scoped
    upload creds. Returns (status, response_body); HTTP errors are returned, not
    raised, so callers can assert on the status (e.g. scope-test wants 403)."""
    access_key = get_secret(R2_ACCESS_KEY_ENV, R2_ACCESS_KEY_KEYCHAIN, "R2 S3 access key id")
    secret = get_secret(R2_SECRET_KEY_ENV, R2_SECRET_KEY_KEYCHAIN, "R2 S3 secret access key")
    host = f"{_r2_account_id()}.r2.cloudflarestorage.com"
    region, service = "auto", "s3"
    now = utc_now()
    amzdate = now.strftime("%Y%m%dT%H%M%SZ")
    datestamp = now.strftime("%Y%m%d")
    payload_hash = hashlib.sha256(body).hexdigest()
    canonical_uri = f"/{bucket}/{key}" if key else f"/{bucket}/"

    headers = {"host": host, "x-amz-content-sha256": payload_hash, "x-amz-date": amzdate}
    if content_type:
        headers["content-type"] = content_type
    signed_headers = ";".join(sorted(headers))
    canonical_headers = "".join(f"{name}:{headers[name]}\n" for name in sorted(headers))
    canonical_request = f"{method}\n{canonical_uri}\n{query}\n{canonical_headers}\n{signed_headers}\n{payload_hash}"

    scope = f"{datestamp}/{region}/{service}/aws4_request"
    string_to_sign = (
        f"AWS4-HMAC-SHA256\n{amzdate}\n{scope}\n"
        f"{hashlib.sha256(canonical_request.encode()).hexdigest()}"
    )

    def _sign(key_bytes: bytes, msg: str) -> bytes:
        return hmac.new(key_bytes, msg.encode(), hashlib.sha256).digest()

    signing_key = _sign(_sign(_sign(_sign(f"AWS4{secret}".encode(), datestamp), region), service), "aws4_request")
    signature = hmac.new(signing_key, string_to_sign.encode(), hashlib.sha256).hexdigest()
    authorization = (
        f"AWS4-HMAC-SHA256 Credential={access_key}/{scope}, "
        f"SignedHeaders={signed_headers}, Signature={signature}"
    )

    url = f"https://{host}{canonical_uri}" + (f"?{query}" if query else "")
    req_headers = {
        "Host": host,
        "x-amz-date": amzdate,
        "x-amz-content-sha256": payload_hash,
        "Authorization": authorization,
    }
    if content_type:
        req_headers["Content-Type"] = content_type
    req = urllib.request.Request(
        url, data=body if method in ("PUT", "POST") else None, method=method, headers=req_headers
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as err:
        return err.code, err.read()
    except urllib.error.URLError as err:
        raise PublishError(f"R2 S3 request failed: {err}") from err


# Text formats a browser will misdecode if we do not name the encoding. Python's
# mimetypes returns a bare `text/html`, and an HTML page served without a charset
# is decoded with the browser's locale default — which turns UTF-8 curly quotes
# and em dashes into mojibake. The Worker repairs this at serve time regardless
# (see contentTypeFor there), but the stored R2 metadata should be right at the
# source too, so anything reading the bucket directly gets the same answer.
TEXTUAL_TYPE_RE = re.compile(r"^text/|^application/(javascript|ecmascript|json|xml)\b|\+xml\b|\+json\b", re.IGNORECASE)


def content_type_for(rel: str) -> str:
    """The Content-Type to store on an uploaded object, with an explicit UTF-8
    charset on every textual type. drop only ever publishes UTF-8 text."""
    guessed = mimetypes.guess_type(rel)[0] or "application/octet-stream"
    if "charset=" in guessed.lower() or not TEXTUAL_TYPE_RE.search(guessed):
        return guessed
    return f"{guessed}; charset=utf-8"


def upload_r2(files: list[tuple[Path, str]], slug: str) -> None:
    bucket = os.environ.get("DROP_R2_BUCKET", DEFAULT_BUCKET)
    for path, rel in files:
        key = f"{slug}/{rel}"
        content_type = content_type_for(rel)
        status, response = s3_request("PUT", bucket, key, body=path.read_bytes(), content_type=content_type)
        if status not in (200, 201):
            raise PublishError(f"R2 upload failed for {rel}: HTTP {status}: {response.decode(errors='ignore')[:200]}")


# --- Stale-object purge after a republish -----------------------------------
#
# A republish uploads the new build over `<slug>/` but nothing removes the files
# the new build dropped. The Worker already refuses to serve them (it gates on
# the manifest's file list), but they sit in the bucket for good, and a later
# republish that reuses one of those names would be the only thing to replace
# them. So after the manifest lands, list the prefix and delete what the new
# file set no longer names.


def s3_query(params: dict[str, str]) -> str:
    """A SigV4 canonical query string. s3_request signs the query verbatim and
    sends the same text, so it has to be canonical already: names sorted, names
    and values URI-encoded with only the unreserved set left bare (a `/` in a
    prefix becomes %2F)."""
    def enc(value: str) -> str:
        return urllib.parse.quote(value, safe="-_.~")

    return "&".join(f"{enc(name)}={enc(params[name])}" for name in sorted(params))


def parse_list_objects(body: bytes) -> tuple[list[str], str | None]:
    """Parse one ListObjectsV2 page into (keys, next continuation token or None).

    Namespace-aware: S3 puts every element in the 2006-03-01 namespace, and a
    plain ``find("Contents")`` would match nothing. The namespace is read off the
    root rather than hardcoded, so an un-namespaced reply parses too."""
    root = ET.fromstring(body)
    ns = root.tag[1:].partition("}")[0] if root.tag.startswith("{") else ""

    def q(name: str) -> str:
        return f"{{{ns}}}{name}" if ns else name

    keys = [el.text for el in root.findall(f"{q('Contents')}/{q('Key')}") if el.text]
    truncated = (root.findtext(q("IsTruncated")) or "").strip().lower() == "true"
    if not truncated:
        return keys, None
    token = (root.findtext(q("NextContinuationToken")) or "").strip()
    if not token:
        raise PublishError("R2 listing was truncated but carried no continuation token")
    return keys, token


def list_r2_keys(bucket: str, prefix: str) -> list[str]:
    """Every object key under ``prefix``, following ListObjectsV2 pagination."""
    keys: list[str] = []
    token: str | None = None
    while True:
        params = {"list-type": "2", "prefix": prefix}
        if token:
            params["continuation-token"] = token
        status, body = s3_request("GET", bucket, query=s3_query(params))
        if status != 200:
            raise PublishError(f"R2 list of {prefix} failed: HTTP {status}: {body.decode(errors='ignore')[:200]}")
        page, token = parse_list_objects(body)
        keys.extend(page)
        if token is None:
            return keys


def stale_keys(keys: list[str], slug: str, keep_rels: set[str]) -> list[str]:
    """The keys under ``<slug>/`` whose rel path is not in the new file set.

    Pure, so it is testable without a bucket. Only keys under this exact prefix
    can come back; a sibling share such as ``<slug>-2/`` shares the leading
    characters but not the trailing slash, so it never matches."""
    prefix = f"{slug}/"
    return [key for key in keys if key.startswith(prefix) and key[len(prefix):] not in keep_rels]


def purge_stale_objects(slug: str, keep_rels: set[str]) -> tuple[int, str | None]:
    """Delete objects under ``<slug>/`` that the just-published manifest no
    longer names. Returns (deleted count, warning or None) and never raises: it
    runs after the manifest POST, so the share is already live with the new
    build, and a cleanup failure must not read as a failed publish."""
    bucket = os.environ.get("DROP_R2_BUCKET", DEFAULT_BUCKET)
    prefix = f"{slug}/"
    deleted = 0
    failed: list[str] = []
    try:
        for key in stale_keys(list_r2_keys(bucket, prefix), slug, keep_rels):
            # stale_keys already filters to the prefix; this re-check is the one
            # line that stands between a bug and deleting another share's bytes.
            if not key.startswith(prefix):
                raise PublishError(f"refusing to delete {key!r}: outside {prefix}")
            # s3_request puts the key into both the signed URI and the URL as
            # given, so hand it the encoded form.
            status, _ = s3_request("DELETE", bucket, urllib.parse.quote(key, safe="/-_.~"))
            if 200 <= status < 300:
                deleted += 1
            else:
                failed.append(f"{key} (HTTP {status})")
    except Exception as err:  # noqa: BLE001 — see docstring: never fail a live publish
        return deleted, f"stale-file purge stopped: {err}; old files may linger in R2 but do not serve"
    if failed:
        shown = ", ".join(failed[:5]) + (" …" if len(failed) > 5 else "")
        return deleted, f"stale-file purge could not delete {len(failed)} file(s): {shown}; they do not serve"
    return deleted, None


# --- Social / link-preview card --------------------------------------------
#
# A shared URL with no OpenGraph image makes messaging apps (iMessage, Slack,
# WhatsApp, …) fall back to screenshotting the page — and a tall page renders as
# a skinny vertical sliver. To fix that we generate a proper 1200x630 landscape
# card (the page title on a background) at publish time, upload it as
# `<slug>/og.png`, and inject og:/twitter: meta tags into the published HTML so
# previews render the card instead of a screenshot.
#
# The renderer is pure stdlib (zlib + struct PNG encoder + an embedded
# public-domain 8x8 bitmap font) so the CLI keeps its no-third-party-deps
# promise and the card is byte-for-byte deterministic. The terminal/bitmap
# aesthetic matches the tool's own look.

# font8x8 by Daniel Hepper <daniel@hepper.net> — Public Domain. Printable ASCII
# only (0x20..0x7E), 8 bytes per glyph (one byte per row, bit 0 = leftmost px).
_OG_FONT_FIRST = 0x20
_OG_FONT_HEX = (
    "0000000000000000183c3c1818001800363600000000000036367f367f3636000c3e031e301f0c00"
    "006333180c6663001c361c6e3b336e000606030000000000180c0606060c1800060c1818180c0600"
    "00663cff3c660000000c0c3f0c0c000000000000000c0c060000003f0000000000000000000c0c00"
    "6030180c060301003e63737b6f673e000c0e0c0c0c0c3f001e33301c06333f001e33301c30331e00"
    "383c36337f3078003f031f3030331e001c06031f33331e003f3330180c0c0c001e33331e33331e00"
    "1e33333e30180e00000c0c00000c0c00000c0c00000c0c06180c0603060c180000003f00003f0000"
    "060c1830180c06001e3330180c000c003e637b7b7b031e000c1e33333f3333003f66663e66663f00"
    "3c66030303663c001f36666666361f007f46161e16467f007f46161e16060f003c66030373667c00"
    "3333333f333333001e0c0c0c0c0c1e007830303033331e006766361e366667000f06060646667f00"
    "63777f7f6b63630063676f7b736363001c36636363361c003f66663e06060f001e3333333b1e3800"
    "3f66663e366667001e33070e38331e003f2d0c0c0c0c1e003333333333333f0033333333331e0c00"
    "6363636b7f7763006363361c1c3663003333331e0c0c1e007f6331184c667f001e06060606061e00"
    "03060c18306040001e18181818181e00081c36630000000000000000000000ff0c0c180000000000"
    "00001e303e336e000706063e66663b0000001e3303331e003830303e33336e0000001e333f031e00"
    "1c36060f06060f0000006e33333e301f0706366e666667000c000e0c0c0c1e00300030303033331e"
    "070666361e3667000e0c0c0c0c0c1e000000337f7f6b630000001f333333330000001e3333331e00"
    "00003b66663e060f00006e33333e307800003b6e66060f0000003e031e301f00080c3e0c0c2c1800"
    "0000333333336e0000003333331e0c000000636b7f7f3600000063361c36630000003333333e301f"
    "00003f190c263f00380c0c070c0c38001818180018181800070c0c380c0c07006e3b000000000000"
)
_OG_FONT = [bytes.fromhex(_OG_FONT_HEX[i * 16 : i * 16 + 16]) for i in range(len(_OG_FONT_HEX) // 16)]


def _og_glyph(ch: str) -> bytes:
    idx = ord(ch) - _OG_FONT_FIRST
    if 0 <= idx < len(_OG_FONT):
        return _OG_FONT[idx]
    return _OG_FONT[ord("?") - _OG_FONT_FIRST]


def _parse_hex_color(value: str | None, default: tuple[int, int, int] | None) -> tuple[int, int, int] | None:
    if not value:
        return default
    raw = value.strip().lstrip("#")
    if len(raw) == 3:
        raw = "".join(c * 2 for c in raw)
    if len(raw) != 6:
        raise PublishError(f"invalid color {value!r}: use a hex color like #0b0d12")
    try:
        return (int(raw[0:2], 16), int(raw[2:4], 16), int(raw[4:6], 16))
    except ValueError:
        raise PublishError(f"invalid color {value!r}: use a hex color like #0b0d12")


def _mix(a: tuple[int, int, int], b: tuple[int, int, int], t: float) -> tuple[int, int, int]:
    return tuple(max(0, min(255, round(a[i] + (b[i] - a[i]) * t))) for i in range(3))  # type: ignore[return-value]


def _png_chunk(tag: bytes, data: bytes) -> bytes:
    return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)


def _png_encode(width: int, height: int, rgb: bytearray) -> bytes:
    stride = width * 3
    raw = bytearray()
    for y in range(height):
        raw.append(0)  # filter type 0 (none)
        raw += rgb[y * stride : (y + 1) * stride]
    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)  # 8-bit truecolor RGB
    return sig + _png_chunk(b"IHDR", ihdr) + _png_chunk(b"IDAT", zlib.compress(bytes(raw), 9)) + _png_chunk(b"IEND", b"")


def _blit_text(buf: bytearray, width: int, height: int, x: int, y: int, text: str, scale: int, color: tuple[int, int, int]) -> None:
    cr, cg, cb = color
    for ch in text:
        glyph = _og_glyph(ch)
        for ry in range(8):
            bits = glyph[ry]
            if not bits:
                continue
            for rx in range(8):
                if not (bits >> rx) & 1:
                    continue
                px0, py0 = x + rx * scale, y + ry * scale
                for sy in range(scale):
                    yy = py0 + sy
                    if yy < 0 or yy >= height:
                        continue
                    base_idx = (yy * width + px0) * 3
                    for sx in range(scale):
                        xx = px0 + sx
                        if xx < 0 or xx >= width:
                            continue
                        idx = base_idx + sx * 3
                        buf[idx] = cr
                        buf[idx + 1] = cg
                        buf[idx + 2] = cb
        x += 8 * scale


def _wrap_text(text: str, max_chars: int) -> list[str]:
    max_chars = max(1, max_chars)
    lines: list[str] = []
    current = ""
    for word in text.split():
        while len(word) > max_chars:  # a single word longer than a line: hard-split
            if current:
                lines.append(current)
                current = ""
            lines.append(word[:max_chars])
            word = word[max_chars:]
        if not current:
            current = word
        elif len(current) + 1 + len(word) <= max_chars:
            current += " " + word
        else:
            lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines or [""]


def render_og_card(
    title: str,
    footer: str,
    *,
    bg: tuple[int, int, int],
    fg: tuple[int, int, int],
    accent: tuple[int, int, int],
    width: int = 1200,
    height: int = 630,
) -> bytes:
    """Render a 1200x630 link-preview card: the title, wrapped and centered, on a
    subtle vertical gradient, with an accent top bar and a mono footer line."""
    buf = bytearray(width * height * 3)
    # Vertical gradient background (base -> a touch lighter, tinted toward accent).
    bottom = _mix(_mix(bg, accent, 0.10), (255, 255, 255), 0.04)
    for y in range(height):
        t = y / (height - 1)
        row = bytes(_mix(bg, bottom, t)) * width
        buf[y * width * 3 : (y + 1) * width * 3] = row
    # Accent bar across the top.
    bar = bytes(accent) * width
    for y in range(10):
        buf[y * width * 3 : (y + 1) * width * 3] = bar

    margin = 80
    usable = width - 2 * margin
    title = title.strip() or footer
    # Pick the largest scale at which the title fits in a sensible number of lines
    # and leaves room for the footer.
    chosen_scale, chosen_lines, line_h = 5, _wrap_text(title, usable // (8 * 5)), 8 * 5 + 10
    for scale in range(11, 4, -1):
        lines = _wrap_text(title, usable // (8 * scale))
        lh = 8 * scale + scale * 2
        max_lines = 4 if scale > 6 else 5
        if len(lines) <= max_lines and len(lines) * lh <= height - 230:
            chosen_scale, chosen_lines, line_h = scale, lines, lh
            break
    else:
        chosen_lines = chosen_lines[:5]

    block_h = len(chosen_lines) * line_h
    y0 = (height - block_h) // 2 - 16
    for i, line in enumerate(chosen_lines):
        _blit_text(buf, width, height, margin, y0 + i * line_h, line, chosen_scale, fg)

    # Footer (host/slug) in the accent color, mono, bottom-left.
    fscale = 3
    footer = footer[: max(1, usable // (8 * fscale))]
    _blit_text(buf, width, height, margin, height - 74, footer, fscale, _mix(accent, bg, 0.15))
    return _png_encode(width, height, buf)


_OG_BLOCK_START = "<!-- drop:og -->"
_OG_BLOCK_END = "<!-- /drop:og -->"
# The page's og:/twitter: description is cut to this many characters.
OG_DESCRIPTION_MAX = 300
# The Worker's cap on a --public-preview title (see validatePreview there).
PREVIEW_TITLE_MAX = 300


def _esc_attr(value: str) -> str:
    return (
        value.replace("&", "&amp;")
        .replace('"', "&quot;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
    )


def extract_title(markup: str) -> str | None:
    match = re.search(r"<title[^>]*>(.*?)</title>", markup, re.IGNORECASE | re.DOTALL)
    if not match:
        return None
    text = html.unescape(re.sub(r"\s+", " ", match.group(1)).strip())
    return text or None


def extract_description(markup: str) -> str | None:
    match = re.search(r"<meta\b[^>]*\bname=[\"']description[\"'][^>]*>", markup, re.IGNORECASE)
    if not match:
        return None
    content = re.search(r"content=[\"'](.*?)[\"']", match.group(0), re.IGNORECASE | re.DOTALL)
    if not content:
        return None
    return html.unescape(re.sub(r"\s+", " ", content.group(1)).strip()) or None


def inject_og_meta(
    markup: str,
    *,
    title: str,
    description: str | None,
    image_url: str,
    page_url: str,
    image_size: tuple[int, int] | None = (1200, 630),
    image_type: str | None = None,
    image_alt: str | None = None,
    site_name: str | None = None,
) -> str:
    """Insert (or replace) an og:/twitter: meta block in the document head. The
    block is delimited by comment markers so republishing replaces it cleanly
    rather than stacking duplicates.

    ``image_size`` defaults to the generated card's 1200x630. Pass None when the
    real size is unknown: no width/height tags is honest, and a wrong pair makes
    some previewers crop or letterbox the image to the stated shape."""
    tags = [
        '<meta property="og:type" content="website">',
        f'<meta property="og:title" content="{_esc_attr(title)}">',
        f'<meta property="og:url" content="{_esc_attr(page_url)}">',
    ]
    if site_name:
        tags.append(f'<meta property="og:site_name" content="{_esc_attr(site_name)}">')
    tags.append(f'<meta property="og:image" content="{_esc_attr(image_url)}">')
    if image_type:
        tags.append(f'<meta property="og:image:type" content="{_esc_attr(image_type)}">')
    if image_size:
        tags.append(f'<meta property="og:image:width" content="{image_size[0]}">')
        tags.append(f'<meta property="og:image:height" content="{image_size[1]}">')
    if image_alt:
        tags.append(f'<meta property="og:image:alt" content="{_esc_attr(image_alt)}">')
    tags += [
        '<meta name="twitter:card" content="summary_large_image">',
        f'<meta name="twitter:title" content="{_esc_attr(title)}">',
        f'<meta name="twitter:image" content="{_esc_attr(image_url)}">',
    ]
    if image_alt:
        tags.append(f'<meta name="twitter:image:alt" content="{_esc_attr(image_alt)}">')
    if description:
        desc = _esc_attr(description[:OG_DESCRIPTION_MAX])
        tags.insert(2, f'<meta property="og:description" content="{desc}">')
        tags.append(f'<meta name="twitter:description" content="{desc}">')
    block = _OG_BLOCK_START + "\n" + "\n".join(tags) + "\n" + _OG_BLOCK_END + "\n"

    # Drop any block we wrote before, so republish is idempotent.
    markup = re.sub(re.escape(_OG_BLOCK_START) + r".*?" + re.escape(_OG_BLOCK_END) + r"\n?", "", markup, flags=re.DOTALL)
    close = re.search(r"</head\s*>", markup, re.IGNORECASE)
    if close:
        return markup[: close.start()] + block + markup[close.start() :]
    open_head = re.search(r"<head\b[^>]*>", markup, re.IGNORECASE)
    if open_head:
        return markup[: open_head.end()] + "\n" + block + markup[open_head.end() :]
    return block + markup


_CHARSET_RE = re.compile(
    r"<meta\b[^>]*(\bcharset\s*=|\bhttp-equiv\s*=\s*[\"']?content-type)", re.IGNORECASE
)


def declares_charset(markup: str) -> bool:
    """True if the document already states its own encoding, in either the modern
    `<meta charset>` form or the legacy `http-equiv="Content-Type"` one. An
    explicit declaration is the author's, including a non-UTF-8 one — we never
    overwrite it."""
    return bool(_CHARSET_RE.search(markup))


def inject_charset_meta(markup: str) -> str:
    """Give an HTML document an explicit `<meta charset="utf-8">` when it declares
    no encoding of its own.

    The served page is already safe — the Worker sends `charset=utf-8` in the
    Content-Type header, which outranks any meta tag. This covers the copy that
    escapes HTTP: a page someone saves and reopens from disk, or forwards as an
    attachment, arrives with no header at all and is decoded with the browser's
    locale default, mojibaking every curly quote and em dash. The tag has to land
    inside the first 1024 bytes to count, so it goes first in <head>."""
    if declares_charset(markup):
        return markup
    tag = '<meta charset="utf-8">'
    open_head = re.search(r"<head\b[^>]*>", markup, re.IGNORECASE)
    if open_head:
        return markup[: open_head.end()] + "\n" + tag + markup[open_head.end() :]
    # No <head>: sit after the doctype if there is one, else lead the document.
    doctype = re.match(r"\s*<!doctype[^>]*>", markup, re.IGNORECASE)
    if doctype:
        return markup[: doctype.end()] + "\n" + tag + markup[doctype.end() :]
    return tag + "\n" + markup


def read_html(path: Path) -> str | None:
    """Decode an HTML file as UTF-8, or None if it is not UTF-8.

    Strict on purpose. Every rewrite below re-encodes as UTF-8, so decoding a
    latin-1 page with errors="ignore" would silently delete the very bytes the
    author cares about and publish the damage. A file we cannot read as UTF-8 is
    published verbatim instead, untouched, with a warning."""
    try:
        return path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, ValueError):
        return None


def _prettify_slug(slug: str) -> str:
    """A human title for a slug, dropping any unguessable random tail."""
    base = re.sub(r"-[a-z0-9]{12,}$", "", slug)
    return base.replace("-", " ").strip().title() or slug


def _html_files(files: list[tuple[Path, str]]) -> list[str]:
    return [rel for _, rel in files if rel.lower().endswith((".html", ".htm"))]


def _entry_html(files: list[tuple[Path, str]]) -> str | None:
    htmls = _html_files(files)
    if not htmls:
        return None
    for rel in htmls:
        if rel.lower() == "index.html":
            return rel
    return sorted(htmls)[0]


# --- Custom link-preview image (--card-image) -------------------------------

# JPEG start-of-frame markers carry the image size. C4 (DHT), C8 (JPG), and CC
# (DAC) sit in the same range but are not frames.
_JPEG_SOF_MARKERS = frozenset(range(0xC0, 0xD0)) - {0xC4, 0xC8, 0xCC}


def _jpeg_dimensions(data: bytes) -> tuple[int, int] | None:
    """Walk JPEG segments to the first SOFn marker and read (width, height)."""
    pos, n = 2, len(data)
    while pos + 4 <= n:
        if data[pos] != 0xFF:
            return None
        marker = data[pos + 1]
        if marker == 0xFF:  # fill byte before a marker
            pos += 1
            continue
        if marker == 0x01 or 0xD0 <= marker <= 0xD7:  # standalone, no length
            pos += 2
            continue
        if marker in (0xD9, 0xDA):  # end of image / start of scan before any frame
            return None
        (length,) = struct.unpack(">H", data[pos + 2 : pos + 4])
        if length < 2:
            return None
        if marker in _JPEG_SOF_MARKERS:
            if pos + 9 > n:
                return None
            # FF Cn, length(2), precision(1), height(2), width(2)
            height, width = struct.unpack(">HH", data[pos + 5 : pos + 9])
            return width, height
        pos += 2 + length
    return None


def _webp_dimensions(data: bytes) -> tuple[int, int] | None:
    chunk = data[12:16]
    if chunk == b"VP8X" and len(data) >= 30:  # extended: 24-bit canvas size minus one
        return int.from_bytes(data[24:27], "little") + 1, int.from_bytes(data[27:30], "little") + 1
    if chunk == b"VP8L" and len(data) >= 25 and data[20] == 0x2F:  # lossless: 14-bit fields minus one
        bits = int.from_bytes(data[21:25], "little")
        return (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
    if chunk == b"VP8 " and len(data) >= 30 and data[23:26] == b"\x9d\x01\x2a":  # lossy key frame
        width, height = struct.unpack("<HH", data[26:30])
        return width & 0x3FFF, height & 0x3FFF
    return None


def image_dimensions(path: Path) -> tuple[int, int] | None:
    """(width, height) of a PNG, JPEG, GIF, or WebP, read from its header with
    the stdlib alone; None when the format or the bytes don't say. Sniffs the
    content, not the extension, so a misnamed file is still read right."""
    try:
        data = path.read_bytes()
    except OSError:
        return None
    try:
        if data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR":
            dims: tuple[int, int] | None = struct.unpack(">II", data[16:24])
        elif data[:6] in (b"GIF87a", b"GIF89a"):
            dims = struct.unpack("<HH", data[6:10])
        elif data[:2] == b"\xff\xd8":
            dims = _jpeg_dimensions(data)
        elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            dims = _webp_dimensions(data)
        else:
            dims = None
    except struct.error:  # truncated header
        return None
    if not dims or dims[0] <= 0 or dims[1] <= 0:
        return None
    return int(dims[0]), int(dims[1])


def check_card_flags(args: argparse.Namespace) -> None:
    """Refuse card options that would be silently ignored, before any slow work.

    Each of these is a flag the user expects to change the preview. If it can't,
    the honest answer is an error now, not a preview that quietly isn't what
    they asked for."""
    for value in (args.card_bg, args.card_fg, args.card_accent):
        _parse_hex_color(value, None)
    if getattr(args, "public_preview", False):
        if args.no_card:
            raise PublishError("--public-preview shows the link-preview card, and --no-card turns it off; drop one")
        if args.card_image:
            # A deliberate limit: a custom image is often a photo, and this flag
            # would serve it to anyone with the link.
            raise PublishError(
                "--public-preview exposes only the generated title card; --card-image is not supported with it yet"
            )
    if args.no_card:
        used = [
            flag
            for flag, value in (
                ("--card-image", args.card_image),
                ("--card-description", args.card_description),
                ("--card-site-name", args.card_site_name),
                ("--card-image-alt", args.card_image_alt),
            )
            if value
        ]
        if used:
            raise PublishError(f"{', '.join(used)} has no effect with --no-card (no preview meta is written); drop one")
    if args.card_image:
        colors = [
            flag
            for flag, value in (("--card-bg", args.card_bg), ("--card-fg", args.card_fg), ("--card-accent", args.card_accent))
            if value
        ]
        if colors:
            raise PublishError(
                f"{', '.join(colors)} only style the generated card, and --card-image replaces it; drop one"
            )
        image = Path(args.card_image).expanduser()
        if image.suffix.lower() not in CARD_IMAGE_TYPES:
            allowed = " ".join(sorted(CARD_IMAGE_TYPES))
            raise PublishError(f"--card-image must be one of {allowed}: {args.card_image}")
        if not image.is_file():
            raise PublishError(f"--card-image not found: {args.card_image}")


def check_public_preview_tier(auth_mode: str, args: argparse.Namespace, slug: str | None = None) -> None:
    """--public-preview only means something on a password share: the other
    tiers serve the whole share, card included, to anyone with the link."""
    if not args.public_preview or auth_mode == "password":
        return
    if slug:
        raise PublishError(
            f"{slug} has no password, so its link preview is already public; drop --public-preview"
        )
    raise PublishError(
        "--public-preview is for password shares; --public and --unlisted shares already show "
        "their link preview to anyone with the link; drop one"
    )


def preview_payload(card_note: dict | None) -> dict:
    """The manifest's `preview` for --public-preview: the exact title and
    description the staged card carries. Checked against the Worker's limits
    here, so a bad value fails before anything uploads."""
    if not card_note or card_note.get("image_source") != "generated":
        raise PublishError("--public-preview needs the generated og.png card, and none was staged")
    title = card_note["title"]
    if not title.strip():
        raise PublishError("--public-preview needs a card title; pass --card-title")
    if len(title) > PREVIEW_TITLE_MAX:
        raise PublishError(
            f"--public-preview: the card title is {len(title)} characters and the limit is "
            f"{PREVIEW_TITLE_MAX}; pass a shorter --card-title"
        )
    return {"title": title, "description": card_note.get("description")}


def resolve_card_image(image_arg: str, files: list[tuple[Path, str]]) -> tuple[Path, str, bool]:
    """Where a --card-image lives in the share: (source path, rel, external).

    An image that is already one of the artifact's files is referenced at its
    existing rel, so it isn't published twice. Anything else is staged in as
    ``og.<ext>``; if the artifact already has a file at that rel, refuse rather
    than let one silently replace the other."""
    source = Path(image_arg).expanduser().resolve()
    for path, rel in files:
        if path.resolve() == source:
            return source, rel, False
    rel = "og" + source.suffix.lower()
    if any(existing == rel for _, existing in files):
        raise PublishError(
            f"--card-image is outside the artifact and would be staged as {rel}, but the artifact "
            f"already has a file at {rel}; pass that file as --card-image, or rename one"
        )
    return source, rel, True


def stage_publish_set(
    files: list[tuple[Path, str]], slug: str, base: str, args: argparse.Namespace
) -> tuple[list[tuple[Path, str]], tempfile.TemporaryDirectory, dict | None, list[str]]:
    """Stage a copy of the publish set with every HTML file fixed up: an explicit
    `<meta charset="utf-8">` when the page declares no encoding, and — unless
    --no-card — a preview image plus og:/twitter: meta.

    The preview image is the generated og.png card, or a --card-image: one of the
    artifact's own files is referenced where it sits, and one from outside the
    artifact is staged in as og.<ext>.

    Nothing here touches the user's files; the rewrites land in a temp dir that
    the caller owns and cleans up. Returns the staged (path, rel) list, that temp
    dir, a card note (None with --no-card), and any warnings to surface.

    The charset pass runs even with --no-card, because a page with no encoding
    declaration is broken the moment it leaves HTTP — saved to disk, forwarded as
    an attachment — and that has nothing to do with link previews."""
    warnings: list[str] = []
    card = not args.no_card
    entry = _entry_html(files)
    entry_path = next(path for path, rel in files if rel == entry)
    markup = read_html(entry_path) or ""

    note: dict | None = None
    png: bytes | None = None
    external_image: tuple[Path, str] | None = None
    meta: dict = {}
    if card:
        title = args.card_title or extract_title(markup) or args.client or args.label or _prettify_slug(slug)
        description = args.card_description or extract_description(markup)
        page_url = f"{base}/{slug}/"
        if args.card_image:
            source, image_rel, external = resolve_card_image(args.card_image, files)
            image_size = image_dimensions(source)
            if image_size is None:
                warnings.append(f"--card-image {source.name}: size unreadable; og:image:width/height left out")
            image_type = CARD_IMAGE_TYPES[source.suffix.lower()]
            if external:
                external_image = (source, image_rel)
            image_source = "staged" if external else "artifact"
        else:
            image_rel, image_size, image_type, image_source = "og.png", (1200, 630), None, "generated"
            host = urllib.parse.urlsplit(base).netloc or base
            bg = _parse_hex_color(args.card_bg, (11, 13, 18))
            fg = _parse_hex_color(args.card_fg, (232, 235, 242))
            accent = _parse_hex_color(args.card_accent, (122, 162, 255))
            png = render_og_card(title, f"{host}/{slug}", bg=bg, fg=fg, accent=accent)
        image_url = f"{base}/{slug}/{urllib.parse.quote(image_rel)}"
        meta = {
            "title": title,
            "description": description,
            "image_url": image_url,
            "page_url": page_url,
            "image_size": image_size,
            "image_type": image_type,
            "image_alt": args.card_image_alt,
            "site_name": args.card_site_name,
        }
        note = {
            "title": title,
            # As the page's og:description carries it; --public-preview sends this.
            "description": description[:OG_DESCRIPTION_MAX] if description else None,
            "image": image_url,
            "image_source": image_source,
            "entry": entry,
        }

    # A single HTML file is the share's entry page: stage it as index.html so the
    # bare `/<slug>/` URL serves it (the Worker's single-file root fallback no
    # longer applies once og.png makes the share multi-file). With --no-card the
    # share stays single-file, so that fallback still applies and the name stands.
    # This counts the artifact's own files only: an external --card-image is the
    # second file just as og.png is, and an in-artifact one means it was never
    # single-file to begin with.
    single_html = card and len(files) == 1 and entry is not None
    tmp = tempfile.TemporaryDirectory(prefix="drop-stage-")
    root = Path(tmp.name)
    staged: list[tuple[Path, str]] = []
    for path, rel in files:
        out_rel = "index.html" if (single_html and rel == entry and rel.lower() != "index.html") else rel
        dest = root / out_rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        page = read_html(path) if rel.lower().endswith((".html", ".htm")) else None
        if page is None:
            # Not HTML, or HTML we cannot decode as UTF-8. Either way, copy the
            # bytes through untouched rather than rewrite something we misread.
            if rel.lower().endswith((".html", ".htm")):
                warnings.append(
                    f"{rel}: not valid UTF-8; published byte-for-byte with no charset or preview meta added"
                )
            shutil.copyfile(path, dest)
        else:
            fixed = inject_charset_meta(page)
            if fixed is not page:
                warnings.append(f'{rel}: no encoding declared; added <meta charset="utf-8">')
            if card:
                fixed = inject_og_meta(fixed, **meta)
            dest.write_text(fixed, encoding="utf-8")
        staged.append((dest, out_rel))
    if png is not None:
        og_dest = root / "og.png"
        og_dest.write_bytes(png)
        staged.append((og_dest, "og.png"))
    if external_image is not None:
        source, image_rel = external_image
        image_dest = root / image_rel
        shutil.copyfile(source, image_dest)
        staged.append((image_dest, image_rel))
    return staged, tmp, note, warnings


def resolve_unique_slug(base: str, admin_token: str) -> str:
    """Pick a free, readable slug: the base name if available, else base-2,
    base-3, … Every existing share counts as taken — including expired and
    revoked ones — so a new artifact never reuses or silently overwrites a name
    that has already been published."""
    data = admin_request("GET", "/admin/list", admin_token)
    taken = {row.get("slug") for row in data.get("shares", [])}
    if base not in taken:
        return base
    n = 2
    while f"{base}-{n}" in taken:
        n += 1
    return f"{base}-{n}"


# --- Existing shares: lookup and republish guards ---------------------------


def admin_token() -> str:
    return get_secret(ADMIN_TOKEN_ENV, ADMIN_TOKEN_KEYCHAIN, "Worker admin token")


def lookup_share(slug: str, token: str) -> dict | None:
    """The /admin/list row for exactly this slug, or None. The Worker has no
    single-share admin read, so this filters the full list. It is a read-only
    GET, which is why it runs even under --dry-run: the refusals and the
    inherited settings it feeds should match what the real publish would do."""
    data = admin_request("GET", "/admin/list", token)
    for row in data.get("shares", []):
        if row.get("slug") == slug:
            return row
    return None


def parse_iso(value: str) -> dt.datetime:
    """Parse a Worker timestamp. Accepts the trailing `Z` that JavaScript's
    toISOString writes (fromisoformat only learned it in 3.11), and reads a
    zone-less value as UTC, which is what the CLI always writes."""
    text = value.strip()
    if text.endswith(("Z", "z")):
        text = text[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError as err:
        raise PublishError(f"unreadable timestamp from the Worker: {value!r}") from err
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)


def share_expired(row: dict, now: dt.datetime | None = None) -> bool:
    """Same rule as the Worker's isExpired: expired once expires_at <= now."""
    expires = row.get("expires_at")
    return bool(expires) and parse_iso(expires) <= (now or utc_now())


VISIBILITIES = ("password", "unlisted", "public")


def share_visibility(row: dict) -> str | None:
    """The tier this CLI recorded for a share when it published it, or None for a
    row published before the CLI recorded one.

    The Worker can't answer this itself: unlisted and public are both
    auth_mode="public" there. So the CLI writes its tier into the manifest's
    scan_result, which the Worker stores verbatim and /admin/list returns. A
    recorded tier is fact; the slug shape (looks_unlisted) is only a fallback for
    older rows."""
    scan = row.get("scan_result")
    value = scan.get("visibility") if isinstance(scan, dict) else None
    return value if value in VISIBILITIES else None


def check_unlisted_republish(slug: str, row: dict | None) -> None:
    """Allow --slug with --unlisted only onto a live share that is already
    unlisted. Anything else would pass off a guessable URL as a secret link, or
    strip a password, or revive something that was meant to end."""
    if row is None:
        raise PublishError(
            f"--unlisted --slug {slug}: no share has that slug, and a new hand-picked slug has no "
            "unguessable tail, leaving an open guessable URL; drop --slug to mint one"
        )
    if row.get("revoked_at"):
        raise PublishError(
            f"{slug} was revoked at {row['revoked_at']}; revoke is an ending, so drop --slug to mint a new unlisted link"
        )
    if share_expired(row):
        raise PublishError(
            f"{slug} expired at {row['expires_at']}; to bring it back with a new expiry, "
            f"run `drop update {slug} --expire <duration> <path>`"
        )
    mode = row.get("auth_mode")
    if mode == "password":
        raise PublishError(
            f"{slug} is a password share; republishing it --unlisted would remove its password. "
            f"Use `drop update {slug} --password <its password> <path>` to keep the tier"
        )
    if mode != "public":
        raise PublishError(f"{slug} has an unknown auth_mode {mode!r}; refusing to guess its tier")
    recorded = share_visibility(row)
    if recorded == "unlisted":
        return
    if recorded is not None:
        raise PublishError(
            f"{slug} was published as a {recorded} share, so --unlisted would not make it secret; "
            f"republish it with `drop update {slug} <path>`, or drop --slug to mint a new unlisted link"
        )
    # No recorded tier (published before the CLI kept one): fall back to the slug shape.
    if not looks_unlisted(slug):
        raise PublishError(
            f"{slug} is a public share with no unguessable tail, so --unlisted would not make it secret; "
            f"republish it with `drop update {slug} <path>`, or drop --slug to mint a new unlisted link"
        )


def check_update_target(slug: str, row: dict | None, args: argparse.Namespace) -> None:
    """Refuse a `drop update` that has nothing sound to inherit from."""
    if row is None:
        raise PublishError(f"no share named {slug}; `drop update` only republishes an existing share (see `drop list`)")
    if row.get("revoked_at"):
        raise PublishError(f"{slug} was revoked at {row['revoked_at']}; revoke is an ending, so publish a new share")
    if share_expired(row) and not args.expire:
        raise PublishError(f"{slug} expired at {row['expires_at']}; pass --expire to republish it with a new expiry")
    mode = row.get("auth_mode")
    if mode == "password" and not args.password:
        # The Worker's manifest upsert requires a verifier for a password share
        # and has no way to keep the stored one, so update can't carry the old
        # password over. Minting a fresh one would lock out everyone who has it.
        raise PublishError(
            f"{slug} is a password share: pass its password with --password. Without it, update would have "
            "to mint a new one and lock out everyone who has the current one. Recipients will still see the "
            "login page once more, because the stored verifier is re-salted on every publish"
        )
    if mode == "public" and args.password:
        raise PublishError(f"{slug} has no password, and update keeps the tier; drop --password")
    if mode not in ("password", "public"):
        raise PublishError(f"{slug} has an unknown auth_mode {mode!r}; refusing to guess its tier")


def inherited_expiry(row: dict | None, args: argparse.Namespace) -> tuple[str | None, str | None]:
    """The expires_at for a republish onto ``row``, plus a warning or None.

    --expire wins. Otherwise a future expiry carries over verbatim (the Worker's
    own string, not a re-formatted copy), so republishing a time-boxed share
    doesn't quietly make it permanent. A past one is dropped: the share is
    being brought back, and keeping a past date would leave it dead on arrival."""
    if args.expire:
        return args.expire.isoformat(), None
    if not row or not row.get("expires_at"):
        return None, None
    if share_expired(row):
        return None, f"{row['slug']} had expired at {row['expires_at']}; the republished share has no expiry"
    return row["expires_at"], None


# --- Publish ----------------------------------------------------------------


def cmd_publish(args: argparse.Namespace) -> None:
    # Reject contradictory tier combinations up front, before any slow work — a
    # silently-ignored flag here means a share the user believes is gated but
    # isn't. (--public/--unlisted are already mutually exclusive via argparse.)
    if (args.public or args.unlisted) and args.password:
        raise PublishError("--password has no effect on --public/--unlisted shares (those tiers have no password); drop one")
    check_public_preview_tier("public" if (args.public or args.unlisted) else "password", args)
    check_card_flags(args)

    # Three visibility tiers (YouTube-style):
    #   default   → password-protected ("draft"): clean readable slug + a password.
    #   --unlisted→ "secret link": no password, but an unguessable slug tail is the
    #               capability — anyone with the link views, nobody can guess it.
    #   --public  → truly public: no password, clean guessable slug (discoverable).
    # To the Worker, --unlisted and --public are both auth_mode="public"; the only
    # difference is the slug (the entropy tail), which is purely CLI-side.
    no_password = args.public or args.unlisted
    token = None
    expires_at = args.expire.isoformat() if args.expire else None
    notes: list[str] = []
    if args.slug:
        # An explicit slug republishes in place. Look the row up before the slow
        # preflight so a refusal costs nothing, and so the dry run inherits and
        # refuses exactly as the real run would.
        token = admin_token()
        row = lookup_share(args.slug, token)
        if args.unlisted:
            check_unlisted_republish(args.slug, row)
        expires_at, note = inherited_expiry(row, args)
        if note:
            notes.append(note)
    publish_artifact(
        args,
        auth_mode="public" if no_password else "password",
        password=None if no_password else (args.password or secrets.token_urlsafe(18)),
        expires_at=expires_at,
        token=token,
        notes=notes,
        visibility="unlisted" if args.unlisted else "public" if args.public else "password",
    )


def cmd_update(slug: str, args: argparse.Namespace) -> None:
    """`drop update <slug> <path>`: republish an existing share in place, taking
    its tier, label, and expiry from the live row instead of from this run's
    flags. That is the difference from plain --slug, which rebuilds the manifest
    from flags alone and so drops whatever the caller forgot to repeat."""
    for flag, value in (("--public", args.public), ("--unlisted", args.unlisted), ("--slug", args.slug)):
        if value:
            raise PublishError(f"{flag} has no place in `drop update`: the slug and tier are inherited from the share")
    check_card_flags(args)

    token = admin_token()
    row = lookup_share(slug, token)
    check_update_target(slug, row, args)
    assert row is not None  # check_update_target raised otherwise
    # The preview is not inherited: like the card itself, it is set per publish,
    # so an update without --public-preview turns it off.
    check_public_preview_tier(row["auth_mode"], args, slug)
    if not (args.client or args.label) and row.get("label"):
        # Also feeds the card title fallback, the same as a passed --label would.
        args.label = row["label"]
    expires_at, _ = inherited_expiry(row, args)
    args.slug = slug
    publish_artifact(
        args,
        auth_mode=row["auth_mode"],
        # check_update_target guarantees --password on a password share; update
        # never mints one.
        password=args.password if row["auth_mode"] == "password" else None,
        expires_at=expires_at,
        token=token,
        notes=[],
        # Carry the recorded tier over. An older no-password row has none, and
        # update does not guess one from the slug: an unrecorded tier stays
        # unrecorded rather than turning a heuristic into a fact.
        visibility=share_visibility(row) or ("password" if row["auth_mode"] == "password" else None),
    )


def publish_artifact(
    args: argparse.Namespace,
    *,
    auth_mode: str,
    password: str | None,
    expires_at: str | None,
    token: str | None,
    notes: list[str],
    visibility: str | None,
) -> None:
    """The one publish path behind both `drop <path>` and `drop update`: scan,
    stage, upload, write the manifest, and (for a republish) purge stale files.

    ``args.slug`` set means an in-place republish onto that exact slug; unset
    means a fresh share whose slug is derived and made unique here. The caller
    has already settled the tier, password, and expiry."""
    path = Path(args.path).expanduser().resolve()
    files = iter_files(path)
    if not args.no_card and not _html_files(files):
        # The preview lives in og: meta inside an HTML page. With no HTML there is
        # nowhere to put it, so these would be silently ignored.
        used = [
            flag
            for flag, value in (
                ("--card-image", args.card_image),
                ("--card-description", args.card_description),
                ("--card-site-name", args.card_site_name),
                ("--card-image-alt", args.card_image_alt),
                ("--public-preview", args.public_preview),
            )
            if value
        ]
        if used:
            raise PublishError(f"{', '.join(used)} needs an HTML page to carry the preview, and {path.name} has none")
    if args.public_preview and any(rel == "og.png" for _, rel in files):
        # The generated card is staged at og.png, the one path the Worker serves
        # without the password. Refuse rather than let the artifact's own file
        # and the card fight over that name.
        raise PublishError(
            f"--public-preview serves the generated card at og.png, and {path.name} already has an og.png; rename it"
        )
    # An external --card-image is published too, so it gets the same filename,
    # PII, and OCR scans as the artifact's own files. (Only when there is HTML
    # to carry the preview; otherwise nothing is staged and nothing uploads.)
    scanned = files
    if args.card_image and not args.no_card and _html_files(files):
        source, _, external = resolve_card_image(args.card_image, files)
        if external:
            scanned = files + [(source, source.name)]
    scan_result = preflight(path, scanned, args)
    if visibility:
        scan_result["visibility"] = visibility
    public_confirm(args)

    in_place = bool(args.slug)
    label = args.client or args.label
    # Readable slug source: an explicit label wins, else the artifact's own
    # file/dir name (a file's extension is dropped — `report.html` -> `report`).
    base_name = path.stem if path.is_file() else path.name
    slug = args.slug or generated_slug(label or base_name, secret=args.unlisted)
    created_at = utc_now().isoformat()
    base = base_url()

    # Resolve the final slug BEFORE building the card: the og:image URL and og:url
    # embed it. Auto-generated slugs get a unique name on clash (ted-page-2, …);
    # an explicit --slug is honored as-is so a known share republishes in place.
    if not args.dry_run:
        if token is None:
            token = admin_token()
        if not in_place:
            slug = resolve_unique_slug(slug, token)

    # Stage the HTML: an explicit <meta charset="utf-8"> when the page declares no
    # encoding, plus (unless --no-card) a link-preview image and og:/twitter: meta
    # so shared links render a landscape card instead of a tall screenshot. Only
    # runs when the share actually contains HTML.
    published = files
    card_tmp: tempfile.TemporaryDirectory | None = None
    card_note: dict | None = None
    try:
        if _html_files(files):
            published, card_tmp, card_note, stage_warnings = stage_publish_set(files, slug, base, args)
            scan_result["warnings"].extend(stage_warnings)

        artifact_sha, total_bytes, file_rows = digest_files(published)
        manifest = {
            "slug": slug,
            "label": label,
            "auth_mode": auth_mode,
            "sha256": artifact_sha,
            "files": file_rows,
            "bytes": total_bytes,
            "scan_result": scan_result,
            "created_at": created_at,
            "expires_at": expires_at,
            "uploader": f"{_actor()}@{socket.gethostname()}",
            "override_log": scan_result["override_log"],
        }
        if password:
            manifest["password_verifier"] = password_verifier(password)
        if args.public_preview:
            manifest["preview"] = preview_payload(card_note)

        if args.dry_run:
            print(json.dumps({"dry_run": True, "url": f"{base}/{slug}/", "card": card_note, "manifest": manifest}, indent=2))
            return

        upload_r2(published, slug)
        admin_request("POST", "/admin/manifest", token, manifest)
    finally:
        if card_tmp is not None:
            card_tmp.cleanup()

    # Only a republish can leave stale files: a fresh auto-named slug was free
    # (resolve_unique_slug saw no row), so its prefix held nothing to begin with.
    purged = 0
    if in_place:
        # Two republishes of one slug can overlap. If another one's manifest
        # landed after ours, its files are live and ours are the stale ones, so a
        # purge from here would delete the winner's bytes. Purge only while the
        # live row still carries this publish's digest. (This narrows the race to
        # the purge itself; closing it fully needs a conditional write on the
        # Worker.)
        try:
            live = lookup_share(slug, token)
        except PublishError as err:
            live, purge_warning = None, f"stale-file purge skipped: could not re-read {slug}: {err}"
        else:
            purge_warning = None if live else f"stale-file purge skipped: {slug} is missing from /admin/list"
        if live and live.get("sha256") != artifact_sha:
            live, purge_warning = None, f"stale-file purge skipped: a newer publish has landed on {slug}"
        if live:
            purged, purge_warning = purge_stale_objects(slug, {rel for _, rel in published})
        if purge_warning:
            notes.append(purge_warning)

    print(f"url: {base}/{slug}/")
    if card_note:
        print(f"card: {card_note['image']}")
    if args.public_preview:
        print("preview: public (title, description and og.png load without the password)")
    if password:
        print(f"password: {password}")
    if expires_at:
        print(f"expires: {expires_at}")
    if purged:
        print(f"purged: {purged} stale file{'' if purged == 1 else 's'}")
    warnings = scan_result["warnings"] + notes
    if warnings:
        print("warnings:", file=sys.stderr)
        for warning in warnings:
            print(f"  - {warning}", file=sys.stderr)


def cmd_list(_: argparse.Namespace) -> None:
    token = get_secret(ADMIN_TOKEN_ENV, ADMIN_TOKEN_KEYCHAIN, "Worker admin token")
    data = admin_request("GET", "/admin/list", token)
    shares = data.get("shares", [])
    if not shares:
        return
    for row in shares:
        revoked = " revoked" if row.get("revoked_at") else ""
        expires = f" expires={row['expires_at']}" if row.get("expires_at") else ""
        label = f" label={row['label']}" if row.get("label") else ""
        views = f" views={row.get('views', 0)}"
        print(f"{row['slug']} {row['auth_mode']} bytes={row['bytes']}{views}{label}{expires}{revoked}")


def cmd_views(args: argparse.Namespace) -> None:
    """Print the view (open) audit trail for one share: total count plus the most
    recent opens (timestamp, IP, truncated User-Agent)."""
    token = get_secret(ADMIN_TOKEN_ENV, ADMIN_TOKEN_KEYCHAIN, "Worker admin token")
    path = f"/admin/views?slug={urllib.parse.quote(args.slug, safe='')}"
    data = admin_request("GET", path, token)
    count = data.get("count", 0)
    print(f"{args.slug}: {count} view{'' if count == 1 else 's'}")
    for view in data.get("views", []):
        at = view.get("at", "?")
        ip = view.get("ip") or "?"
        ua = view.get("ua")
        line = f"  {at}  {ip}"
        if ua:
            line += f"  {ua}"
        print(line)


def cmd_revoke(args: argparse.Namespace) -> None:
    token = get_secret(ADMIN_TOKEN_ENV, ADMIN_TOKEN_KEYCHAIN, "Worker admin token")
    data = admin_request("POST", "/admin/revoke", token, {"slug": args.slug, "actor": f"{_actor()}@{socket.gethostname()}"})
    print(f"revoked {data.get('slug', args.slug)} deleted={data.get('deleted', 0)}")


def cmd_scope_test(_: argparse.Namespace) -> None:
    """Prove the upload creds are bucket-scoped: they must be able to write our
    own bucket but be denied (401/403) on a known forbidden bucket. This tests
    the credentials actually used for uploads, over the same S3 path they use.

    Set DROP_FORBIDDEN_R2_BUCKET to a bucket on the same account that the upload
    creds must NOT reach (e.g. another app's bucket)."""
    bucket = os.environ.get("DROP_R2_BUCKET", DEFAULT_BUCKET)
    forbidden = os.environ.get("DROP_FORBIDDEN_R2_BUCKET", DEFAULT_FORBIDDEN_R2_BUCKET)
    failures: list[str] = []

    # 1) The forbidden bucket must be unreachable (skipped if none configured).
    status = None
    if forbidden:
        status, _ = s3_request("GET", forbidden, query="list-type=2&max-keys=1")
        if status not in (401, 403):
            failures.append(f"S3 read of forbidden bucket '{forbidden}' returned HTTP {status}; expected 401/403")
    else:
        print("scope-test: no DROP_FORBIDDEN_R2_BUCKET set; skipping the forbidden-bucket check", file=sys.stderr)

    # 2) Our own bucket must be writable (proves the creds are valid, not just dead).
    probe_key = "scope-test/probe.txt"
    put_status, put_body = s3_request("PUT", bucket, probe_key, body=b"scope-test\n", content_type="text/plain")
    if put_status not in (200, 201):
        failures.append(f"S3 write to own bucket '{bucket}' returned HTTP {put_status}: {put_body.decode(errors='ignore')[:120]}")
    else:
        s3_request("DELETE", bucket, probe_key)  # best-effort cleanup

    if failures:
        raise PublishError("scope-test failed:\n  - " + "\n  - ".join(failures))
    if forbidden:
        print(f"scope-test passed: upload creds write '{bucket}' OK and are denied on '{forbidden}' (HTTP {status})")
    else:
        print(f"scope-test passed: upload creds write '{bucket}' OK (no forbidden bucket configured to deny-check)")


def build_parser(prog: str = "drop") -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=prog)
    parser.add_argument("--client", help="client/recipient label; sets the readable slug (default: the file/dir name)")
    parser.add_argument("--label", help="internal label when --client is not appropriate; also sets the readable slug")
    # Visibility (default = password-protected). --public and --unlisted both drop
    # the password; they differ only in the slug (guessable vs unguessable).
    visibility = parser.add_mutually_exclusive_group()
    visibility.add_argument("--public", action="store_true", help="truly public: no password, clean guessable URL (discoverable)")
    visibility.add_argument("--unlisted", action="store_true", help="secret link: no password, unguessable URL — share the link directly")
    parser.add_argument("--password", help="set an explicit password instead of generating one (password tier only)")
    parser.add_argument("--expire", type=parse_duration, help="server-side expiry duration, e.g. 7d")
    # Link-preview (OpenGraph/Twitter) card. Generated for HTML shares so a shared
    # URL renders a landscape card instead of a tall page screenshot.
    parser.add_argument("--card-title", metavar="TEXT", help="title shown on the link-preview card (default: the page <title>)")
    parser.add_argument("--card-bg", metavar="HEX", help="card background color, e.g. #0b0d12")
    parser.add_argument("--card-fg", metavar="HEX", help="card title color, e.g. #e8ebf2")
    parser.add_argument("--card-accent", metavar="HEX", help="card accent color, e.g. #7aa2ff")
    parser.add_argument("--card-description", metavar="TEXT", help="preview description (default: the page's meta description)")
    parser.add_argument("--card-image", metavar="PATH", help="use this .png/.jpg/.gif/.webp as the preview image instead of generating a card")
    parser.add_argument("--card-image-alt", metavar="TEXT", help="alt text for the preview image (og:image:alt, twitter:image:alt)")
    parser.add_argument("--card-site-name", metavar="TEXT", help="site name shown with the preview (og:site_name)")
    parser.add_argument("--no-card", action="store_true", help="do not generate a link-preview card or inject preview meta tags")
    parser.add_argument(
        "--public-preview",
        action="store_true",
        help="password shares only: show the link-preview card (title, description, generated og.png) to anyone "
        "with the link, without the password; not kept on republish unless passed again",
    )
    # Republish: an exact slug skips the clash resolver, so the bytes land on that
    # slug's own prefix and the manifest row is upserted in place. The row is
    # looked up (for expiry, and for --unlisted's checks) but a slug with no row is
    # still allowed — a typo publishes a new share, so copy the slug out of `drop
    # list`, or use `drop update`, which refuses an unknown slug.
    parser.add_argument("--slug", metavar="SLUG", help="republish in place at an exact existing slug, keeping the URL (skips the -2/-3 clash suffix)")
    parser.add_argument("--allow-secret", metavar="REASON", help="override gitleaks findings; reason is logged")
    parser.add_argument("--allow-pii", metavar="REASON", help="override high-confidence PII findings; reason is logged")
    parser.add_argument("--confirm-image-limitation", action="store_true", help="accept manual review when OCR is unavailable or fails")
    parser.add_argument("--yes", action="store_true", help="accept the final public-internet confirmation")
    parser.add_argument("--dry-run", action="store_true", help="run preflight and print the manifest without uploading")
    parser.add_argument("path", nargs="?", help="file or directory to publish")
    parser.set_defaults(func=cmd_publish)
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "list":
        try:
            cmd_list(argparse.Namespace())
            return 0
        except PublishError as err:
            die(str(err))
    if argv and argv[0] == "revoke":
        if len(argv) != 2:
            die("usage: drop revoke <slug>", code=2)
        try:
            cmd_revoke(argparse.Namespace(slug=argv[1]))
            return 0
        except PublishError as err:
            die(str(err))
    if argv and argv[0] == "views":
        if len(argv) != 2:
            die("usage: drop views <slug>", code=2)
        try:
            cmd_views(argparse.Namespace(slug=argv[1]))
            return 0
        except PublishError as err:
            die(str(err))
    if argv and argv[0] == "update":
        usage = "usage: drop update <slug> [flags] <path>"
        if len(argv) < 2 or argv[1].startswith("-"):
            die(usage, code=2)
        args = build_parser(prog="drop update <slug>").parse_args(argv[2:])
        if not args.path:
            die(usage, code=2)
        try:
            cmd_update(argv[1], args)
            return 0
        except PublishError as err:
            die(str(err))
    if argv and argv[0] == "scope-test":
        try:
            cmd_scope_test(argparse.Namespace())
            return 0
        except PublishError as err:
            die(str(err))
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if not args.path:
            parser.error("missing path")
        args.func(args)
        return 0
    except PublishError as err:
        die(str(err))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
